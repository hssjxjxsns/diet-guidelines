# 内置数据库：默认使用 H2 文件库，无需安装任何数据库服务
# 数据文件位于 backend/data/diet-guide.mv.db；如需换路径可覆盖 DATABASE_URL
# DATABASE_URL=jdbc:h2:file:./data/diet-guide;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;NON_KEYWORDS=KEY
DATABASE_USER=sa
DATABASE_PASSWORD=

# 智谱 AI（只在服务端配置，不要下发到前端）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-5.3-flash
ZHIPU_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

PORT=9000

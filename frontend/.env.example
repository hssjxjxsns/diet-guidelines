# ---- 前端可公开的配置（会打包进客户端，禁止放服务端密钥）----
# 后端地址，本地默认 http://localhost:9000/api
# Android 模拟器访问宿主机用 http://10.0.2.2:9000/api
# 真机调试用电脑局域网 IP，例如 http://192.168.1.10:9000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:9000/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Expo Dev Server 固定端口 3001（见 package.json 的 start 脚本）
EXPO_DEV_PORT=3001

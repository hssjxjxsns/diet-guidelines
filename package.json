{
  "name": "diet-guidelines-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Dietary guidelines AI monorepo: Spring Boot backend (apps/server) and mobile client (apps/mobile)",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace @diet/mobile",
    "mobile": "npm start --workspace @diet/mobile",
    "server": "mvn -f apps/server/pom.xml spring-boot:run",
    "server:test": "mvn -f apps/server/pom.xml test",
    "server:build": "mvn -f apps/server/pom.xml -DskipTests package"
  },
  "engines": {
    "node": ">=20"
  }
}
